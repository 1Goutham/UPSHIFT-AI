# ---------------------------------------------------------------------------
# UPSHIFT AI configuration. Copy to .env.local. Everything is optional; the
# app runs without any of it (embedded database, no model features).
# ---------------------------------------------------------------------------

# AI provider (server-side only, never sent to the browser).
# Enables model-drafted briefs, prompt rewrites/refinement and model review
# of outputs (including screenshots). Without a key, rule-based checks,
# browser checks, structured prompts and correction prompts still work.
#
# Grok (xAI): OpenAI-compatible chat completions with json_schema output.
XAI_API_KEY=
# XAI_MODEL=grok-4-fast
# XAI_API_BASE=https://api.x.ai/v1
# Optional, USD per million tokens, only for the cost estimate in Settings:
# XAI_PRICE_INPUT=
# XAI_PRICE_OUTPUT=
#
# Claude (Anthropic):
# ANTHROPIC_API_KEY=
# UPSHIFT_MODEL=claude-opus-5-5
# UPSHIFT_FALLBACKS=on
#
# With both keys set, Claude is used unless you choose explicitly:
# UPSHIFT_PROVIDER=xai

# Database. Unset = embedded PGlite under .data/pglite (single instance only).
# DATABASE_URL=postgres://upshift:upshift@localhost:5432/upshift

# File storage for uploads and screenshots.
# On Vercel: connect a Blob store (adds BLOB_READ_WRITE_TOKEN). Files are private.
# BLOB_READ_WRITE_TOKEN=
# Locally without a token: disk under .data/uploads
# UPSHIFT_STORAGE_DIR=.data/uploads

# Browser checks (headless Chromium via playwright-core). On Vercel the
# bundled @sparticuz/chromium is used automatically.
# UPSHIFT_CHROMIUM_PATH=/path/to/chrome
# Needed when the server runs as root in a container:
# UPSHIFT_CHROMIUM_NO_SANDBOX=true
# UPSHIFT_BROWSER=off

# If the server must reach the internet through a proxy for URL audits.
# DNS-pinning protection is weaker in this mode; each hop is still pre-checked.
# UPSHIFT_OUTBOUND_PROXY=http://proxy:3128

# Local development / tests only: allow auditing localhost and private IPs.
# Ignored when NODE_ENV=production.
# UPSHIFT_ALLOW_PRIVATE_URLS=true

# Sign-up/sign-in attempts per IP per 10 minutes (default 10).
# UPSHIFT_AUTH_RATE_LIMIT=10
