{
  "manifest_version": 3,
  "name": "UPSHIFT — get more out of every AI",
  "short_name": "UPSHIFT",
  "version": "0.1.0",
  "description": "Analyse and refine your prompt right where you write it, on ChatGPT, Claude, Gemini and Grok.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_popup": "popup.html", "default_title": "UPSHIFT", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "options_ui": { "page": "popup.html?page", "open_in_tab": true },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://grok.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "commands": {
    "toggle-upshift": { "suggested_key": { "default": "Alt+U" }, "description": "Open UPSHIFT on the current AI tool" }
  }
}
